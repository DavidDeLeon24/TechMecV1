<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechMec</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechMec.styles.css" asp-append-version="true" />
    <!-- Include FontAwesome for your icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @if (User.IsInRole("SystemAdmin"))
                {
                    <a class="navbar-brand" asp-area="SystemAdmin" asp-controller="Dashboard" asp-action="Index">TechMec</a>
                }
                else if (User.IsInRole("UnitSupervisor"))
                {
                    <a class="navbar-brand" asp-area="UnitSupervisor" asp-controller="Dashboard" asp-action="Index">TechMec</a>
                }
                else if (User.IsInRole("ChargeNurse"))
                {
                    <a class="navbar-brand" asp-area="ChargeNurse" asp-controller="Dashboard" asp-action="Index">TechMec</a>
                }
                else
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TechMec</a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (User.IsInRole("SystemAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="SystemAdmin" asp-controller="User" asp-action="Index">Manage Users</a>
                            </li>
                        }
                        else if (User.IsInRole("UnitSupervisor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/UnitSupervisor/Dashboard">Unit Supervisor</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/UnitSupervisor/Handover">Handovers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/UnitSupervisor/Patient">Patients</a>
                            </li>
                        }
                        else if (User.IsInRole("ChargeNurse"))
                        {
                            <!-- CHARGE NURSE NAV LINKS (NO "HOME") -->
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ChargeNurse/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ChargeNurse/Handover">Handovers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ChargeNurse/Patient">Patients</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ChargeNurse/Task">Tasks</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">Hello, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TechMec
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>