@model IEnumerable<TechMec.Models.Handover>

@{
    ViewData["Title"] = "My Handovers";
}

<h1>My Handover Inbox</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Shift</th>
            <th>From</th>
            <th>Handover Time</th>
            <th>Acknowledged</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Patient?.FirstName @item.Patient?.LastName</td>
                <td>@item.ShiftType</td>
                <td>@item.FromUser?.FullName</td>
                <td>@item.HandoverTime.ToString("g")</td>
                <td>@(item.IsAcknowledged ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.HandoverId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>