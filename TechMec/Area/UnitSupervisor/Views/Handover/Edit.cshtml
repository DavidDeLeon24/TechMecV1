@model TechMec.Models.Handover

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Handover</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="HandoverId" />
            <input type="hidden" asp-for="PatientId" />

            <div class="form-group">
                <label asp-for="ShiftType" class="control-label"></label>
                <input asp-for="ShiftType" class="form-control" />
                <span asp-validation-for="ShiftType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FromUserId" class="control-label"></label>
                <input asp-for="FromUserId" class="form-control" />
                <span asp-validation-for="FromUserId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ToUserId" class="control-label"></label>
                <input asp-for="ToUserId" class="form-control" />
                <span asp-validation-for="ToUserId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SpecialInstructions" class="control-label"></label>
                <input asp-for="SpecialInstructions" class="form-control" />
                <span asp-validation-for="SpecialInstructions" class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Save Changes"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>