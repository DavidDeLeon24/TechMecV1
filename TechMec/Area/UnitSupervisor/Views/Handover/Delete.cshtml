@model TechMec.Models.Handover

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Handover Form</h1>

<h3>Are you sure you want to delete this Form?</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PatientId)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PatientId)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ShiftType)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ShiftType)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FromUserId)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FromUserId)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ToUserId)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ToUserId)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SpecialInstructions)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SpecialInstructions)
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="HandoverId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>