@model IEnumerable<(TechMec.Models.ApplicationUser User, string Role)>

@{
    ViewData["Title"] = "System Admin";
}

<div class="container mt-4">

    <!-- Header Section -->
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold text-primary">
                Welcome Back, System Admin
            </h1>
            <p class="lead text-muted">
                You have full access to manage system users and oversee platform operations.
            </p>
        </div>

        <div class="col-md-4 text-md-end text-center mt-3 mt-md-0">
            <a asp-area="SystemAdmin"
               asp-controller="User"
               asp-action="Index"
               class="btn btn-primary btn-lg shadow-sm px-4">
                Manage Users
            </a>
        </div>
    </div>

    <hr />

    <!-- Nurses Overview -->
    <div class="d-flex justify-content-between align-items-end mt-4 mb-3">
        <h3 class="fw-bold mb-0">Registered Nurses Overview</h3>

        <span class="badge bg-secondary fs-6">
            Total: @(Model?.Count() ?? 0)
        </span>
    </div>

    <!-- Nurses Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <table class="table table-hover table-striped mb-0">

                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Employee ID</th>
                        <th>Full Name</th>
                        <th>Department</th>
                        <th>Role</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center py-4 text-muted">
                                No nurse accounts found in the system.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle ps-3">
                                    @item.User.UserName
                                </td>

                                <td class="align-middle">
                                    @item.User.FullName
                                </td>

                                <td class="align-middle">
                                    @(item.User.Department ?? "-")
                                </td>

                                <td class="align-middle">
                                    <span class="badge bg-info text-dark">
                                        @item.Role
                                    </span>
                                </td>

                                <td class="align-middle">
                                    @if (item.User.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Deactivated
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
