@{
    ViewData["Title"] = "System Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-server text-secondary me-2"></i>IT Administration</h2>
</div>

<div class="alert alert-warning">
    <i class="fa-solid fa-triangle-exclamation me-2"></i> <strong>Restricted Area:</strong> As per system constraints, Admins have NO access to clinical data (Handovers, Patient Records).
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-users-gear fa-3x text-primary mb-3"></i>
                <h4>User Management</h4>
                <p class="text-muted">Create, update, or deactivate accounts for Nurses, Supervisors, and other Admins.</p>
                <a asp-area="SystemAdmin" asp-controller="User" asp-action="Index" class="btn btn-primary px-4 mt-2">Manage Users</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-database fa-3x text-success mb-3"></i>
                <h4>System Health</h4>
                <p class="text-muted">Check database connection status, run backups, and view server logs.</p>
                <button class="btn btn-outline-success px-4 mt-2">View System Status</button>
            </div>
        </div>
    </div>
</div>