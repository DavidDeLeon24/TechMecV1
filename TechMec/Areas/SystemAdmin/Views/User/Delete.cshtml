@model TechMec.Models.ApplicationUser

@{
    ViewData["Title"] = "Deactivate User";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4>Deactivate Account</h4>
                </div>
                <div class="card-body text-center">
                    <h5>Are you sure you want to deactivate this account?</h5>
                    <p class="text-muted">They will no longer be able to log in, but their handover records will be saved.</p>

                    <div class="bg-light p-3 rounded mb-3 text-start">
                        <strong>Name:</strong> @Model.FullName <br />
                        <strong>ID:</strong> @Model.UserName
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">Deactivate</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>  