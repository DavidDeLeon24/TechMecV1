@model TechMec.Models.Patient

@{
    ViewData["Title"] = "Delete Patient";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Delete Patient</h2>

    <p class="text-danger">
        Are you sure you want to delete this patient?
    </p>

    <hr />

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <h5>Patient Information</h5>

            <hr />

            <p>
                <strong>Patient ID:</strong>
                @Model.PatientId
            </p>

            <p>
                <strong>First Name:</strong>
                @Model.FirstName
            </p>

            <p>
                <strong>Last Name:</strong>
                @Model.LastName
            </p>

            <p>
                <strong>Date of Birth:</strong>
                @Model.DateOfBirth.ToShortDateString()
            </p>

            <p>
                <strong>Room Number:</strong>
                @Model.RoomNumber
            </p>

            <p>
                <strong>Diagnosis:</strong>
                @Model.Diagnosis
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

            <hr />

            <!-- FIXED FORM ROUTING -->
            <form asp-area="UnitSupervisor" asp-controller="Patient" asp-action="Delete" asp-route-id="@Model.PatientId" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.PatientId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete Patient
                </button>

                <a href="/UnitSupervisor/Patient"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>