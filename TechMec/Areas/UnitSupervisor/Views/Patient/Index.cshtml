@model IEnumerable<TechMec.Models.Patient>

@{
    ViewData["Title"] = "Unit Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Unit Details</h2>

    <hr />

    <div class="mb-4">
        <h5>Admitted: @Model.Count()</h5>
    </div>

    <div class="mb-4">
        <a href="/UnitSupervisor/Patient/Create"
           class="btn btn-primary">
            + Add New Patient
        </a>
    </div>

    <h3>Patients In This Unit</h3>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Patient ID</th>
                <th>Name</th>
                <th>Room Number</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.PatientId
                    </td>

                    <td>
                        @item.FirstName @item.LastName
                    </td>

                    <td>
                        @item.RoomNumber
                    </td>

                    <td>
                        <a href="/UnitSupervisor/Patient/Details/@item.PatientId"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a href="/UnitSupervisor/Patient/Edit/@item.PatientId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a href="/UnitSupervisor/Patient/Delete/@item.PatientId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

    @if (!Model.Any())
    {
        <p class="text-muted">
            No patients have been added yet.
        </p>
    }

</div>
