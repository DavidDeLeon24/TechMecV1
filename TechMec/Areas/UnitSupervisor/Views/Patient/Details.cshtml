@model TechMec.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Patient Details</h2>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h5>Patient Information</h5>

            <p><strong>Patient ID:</strong> @Model.PatientId</p>

            <p><strong>First Name:</strong> @Model.FirstName</p>

            <p><strong>Last Name:</strong> @Model.LastName</p>

            <p><strong>Date of Birth:</strong> @Model.DateOfBirth.ToShortDateString()</p>

            <p><strong>Room Number:</strong> @Model.RoomNumber</p>

            <p><strong>Diagnosis:</strong> @Model.Diagnosis</p>

            <p><strong>Status:</strong> @Model.Status</p>

            <hr />

            <a href="/UnitSupervisor/Patient/Edit/@Model.PatientId"
               class="btn btn-warning">
                Edit Patient
            </a>

            <a href="/UnitSupervisor/Patient"
               class="btn btn-secondary">
                Back to Patients
            </a>

        </div>
    </div>

</div>
