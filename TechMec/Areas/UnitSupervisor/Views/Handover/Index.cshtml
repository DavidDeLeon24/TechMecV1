@model IEnumerable<TechMec.Models.Handover>

@{
    ViewData["Title"] = "Handovers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>Handovers</h1>

    <p>
        <a href="/UnitSupervisor/Handover/Create" class="btn btn-primary">+ Create New Handover</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Shift</th>
                <th>From Nurse</th>
                <th>To Nurse</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-4">No handovers found.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Patient != null ? item.Patient.FirstName + " " + item.Patient.LastName : "N/A")</td>
                    <td>@item.ShiftType</td>
                    <td>@(item.FromUser != null ? item.FromUser.FullName : "N/A")</td>
                    <td>@(item.ToUser != null ? item.ToUser.FullName : "N/A")</td>
                    <td>
                        <a href="/UnitSupervisor/Handover/Details/@item.HandoverId" class="btn btn-sm btn-outline-info">Details</a>
                        <a href="/UnitSupervisor/Handover/Edit/@item.HandoverId" class="btn btn-sm btn-outline-warning">Edit</a>
                        <a href="/UnitSupervisor/Handover/Delete/@item.HandoverId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>