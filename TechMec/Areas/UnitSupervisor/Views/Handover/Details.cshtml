@model TechMec.Models.Handover

@{
    ViewData["Title"] = "Handover Details";
}

<div class="container mt-4">
    <h2>Handover Details</h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Patient</dt>
        <dd class="col-sm-9">@Model.Patient.FirstName @Model.Patient.LastName (Room @Model.Patient.RoomNumber)</dd>

        <dt class="col-sm-3">Shift</dt>
        <dd class="col-sm-9">@Model.ShiftType</dd>

        <dt class="col-sm-3">From Nurse</dt>
        <dd class="col-sm-9">@Model.FromUser.FullName</dd>

        <dt class="col-sm-3">To Nurse</dt>
        <dd class="col-sm-9">@Model.ToUser.FullName</dd>

        <dt class="col-sm-3">Special Instructions</dt>
        <dd class="col-sm-9">@Model.SpecialInstructions</dd>

        <dt class="col-sm-3">Created At</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime()</dd>
    </dl>

    <a href="/UnitSupervisor/Handover" class="btn btn-secondary">Back to List</a>
</div>