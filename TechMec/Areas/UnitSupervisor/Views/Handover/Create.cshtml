@model TechMec.Area.UnitSupervisor.Controllers.HandoverController.CreateHandoverInput
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Create Handover";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Create Patient Handover</h2>
    <p class="text-muted">
        Enter the handover information below.
    </p>

    <hr />

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <form action="/UnitSupervisor/Handover/Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <h5>Patient Information</h5>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="PatientId"
                               class="form-label">
                            Select Patient
                        </label>

                        <select asp-for="PatientId"
                                asp-items="ViewBag.Patients"
                                class="form-select">
                            <option value="0">-- Select Patient --</option>
                        </select>

                        <span asp-validation-for="PatientId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ShiftType"
                               class="form-label">
                            Select Shift
                        </label>

                        <select asp-for="ShiftType"
                                class="form-select">
                            <option value="">-- Select Shift --</option>
                            <option value="1">Morning</option>
                            <option value="2">Afternoon</option>
                            <option value="3">Night</option>
                        </select>

                        <span asp-validation-for="ShiftType"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <h5>Nurse Information</h5>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="FromNurseName"
                               class="form-label">
                            From Nurse
                        </label>

                        <input asp-for="FromNurseName"
                               class="form-control"
                               placeholder="Enter nurse's full name" />

                        <span asp-validation-for="FromNurseName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ToNurseName"
                               class="form-label">
                            To Nurse
                        </label>

                        <input asp-for="ToNurseName"
                               class="form-control"
                               placeholder="Enter nurse's full name" />

                        <span asp-validation-for="ToNurseName"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <h5>Additional Information</h5>

                <div class="mb-3">
                    <label asp-for="SpecialInstructions"
                           class="form-label">
                        Special Instructions
                    </label>

                    <textarea asp-for="SpecialInstructions"
                              class="form-control"
                              rows="5"
                              placeholder="Enter patient updates or instructions..."></textarea>

                    <span asp-validation-for="SpecialInstructions"
                          class="text-danger"></span>
                </div>

                <hr />

                <button type="submit"
                        class="btn btn-primary">
                    Create Handover
                </button>

                <a href="/UnitSupervisor/Handover"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
