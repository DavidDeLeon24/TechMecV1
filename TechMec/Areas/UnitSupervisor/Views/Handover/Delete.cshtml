@model TechMec.Models.Handover

@{
    ViewData["Title"] = "Delete Handover";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Handover</h2>
    <h4>Are you sure you want to delete this handover for Patient: @Model.Patient.FirstName @Model.Patient.LastName?</h4>
    <hr />

    <form asp-area="UnitSupervisor" asp-controller="Handover" asp-action="Delete" method="post">
        <input type="hidden" asp-for="HandoverId" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a href="/UnitSupervisor/Handover" class="btn btn-secondary">Cancel</a>
    </form>
</div>