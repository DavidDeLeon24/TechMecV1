@model TechMec.Models.Handover

@{
    ViewData["Title"] = "Edit Handover";
}

<div class="container mt-4">
    <h2>Edit Handover</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-area="UnitSupervisor" asp-controller="Handover" asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="HandoverId" />

                <div class="form-group mb-3">
                    <label asp-for="ShiftType" class="control-label"></label>
                    <select asp-for="ShiftType" class="form-control" asp-items="Html.GetEnumSelectList<TechMec.Models.HandoverShift>()"></select>
                    <span asp-validation-for="ShiftType" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SpecialInstructions" class="control-label"></label>
                    <textarea asp-for="SpecialInstructions" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="SpecialInstructions" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/UnitSupervisor/Handover" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>