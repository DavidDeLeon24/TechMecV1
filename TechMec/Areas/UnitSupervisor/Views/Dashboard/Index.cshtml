@{
    ViewData["Title"] = "Unit Supervisor Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="p-4 bg-white rounded shadow-sm border-start border-4 border-info">
            <h2 class="mb-1"><i class="fa-solid fa-user-tie text-info me-2"></i>Supervisor Oversight</h2>
            <p class="text-muted mb-0">Monitor handover completion rates, audit trails, and overall unit compliance.</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-dark text-white fw-bold"><i class="fa-solid fa-list-check me-2"></i>Unit Overview</div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Shift Handover Completion Rate
                        <span class="badge bg-success rounded-pill">94%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Pending Acknowledgment (Overdue)
                        <span class="badge bg-danger rounded-pill">3</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Active Floor Nurses
                        <span class="badge bg-primary rounded-pill">12</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-header bg-white fw-bold"><i class="fa-solid fa-chart-line text-secondary me-2"></i>Audit & Reporting</div>
            <div class="card-body d-flex flex-column justify-content-center text-center">
                <p class="text-muted">View complete system logs, incident reports, and medication error tracking.</p>
                <button class="btn btn-outline-dark">View Audit Logs (FR-120)</button>
            </div>
        </div>
    </div>
</div>