@{
    ViewData["Title"] = "Unit Supervisor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>Welcome Unit Supervisor</h1>
    <p>Select an option below:</p>

    <div class="row">
        <!-- HANDOVER -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h3>Handover</h3>
                    <p>View and manage patient handovers.</p>
                    <!-- FIXED LINK -->
                    <a href="/UnitSupervisor/Handover" class="btn btn-primary">
                        View Handovers
                    </a>
                </div>
            </div>
        </div>

        <!-- UNIT DETAILS -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h3>Unit Details</h3>
                    <p>View patient and unit information.</p>
                    <!-- FIXED LINK -->
                    <a href="/UnitSupervisor/Patient" class="btn btn-primary">
                        View Unit Details
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>