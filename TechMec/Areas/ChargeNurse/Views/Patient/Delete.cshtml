@model TechMec.Models.Patient
@{
    ViewData["Title"] = "Delete Patient";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete Patient</h3>
    <a href="/ChargeNurse/Patient/Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm border-0 border-start border-4 border-danger">
    <div class="card-body p-4">
        <h5>Are you sure you want to delete this patient?</h5>
        <p class="text-muted">This action cannot be undone. All associated handovers and notes will also be deleted.</p>

        <dl class="row mt-4">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Room Number</dt>
            <dd class="col-sm-9">@Model.RoomNumber</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />
            <button type="submit" class="btn btn-danger px-4">Yes, Delete</button>
            <a href="/ChargeNurse/Patient/Index" class="btn btn-secondary px-4">Cancel</a>
        </form>
    </div>
</div>