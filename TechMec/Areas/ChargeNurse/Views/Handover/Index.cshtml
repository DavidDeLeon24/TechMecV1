@model IEnumerable<TechMec.Models.Handover>

@{
    ViewData["Title"] = "Handovers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Handovers</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Shift</th>
            <th>From</th>
            <th>To</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No handovers found.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Patient != null ? item.Patient.FirstName + " " + item.Patient.LastName : "N/A")</td>
                    <td>@item.ShiftType</td>
                    <td>@(item.FromUser != null ? item.FromUser.FullName : "N/A")</td>
                    <td>@(item.ToUser != null ? item.ToUser.FullName : "N/A")</td>
                    <td>
                        <a href="/ChargeNurse/Handover/Details/@item.HandoverId" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>