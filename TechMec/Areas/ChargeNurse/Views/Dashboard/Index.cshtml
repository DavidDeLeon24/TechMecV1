@{
    ViewData["Title"] = "Charge Nurse Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-clipboard-list text-primary me-2"></i>Shift Handover Overview</h2>
    <a href="#" class="btn btn-success btn-lg shadow-sm"><i class="fa-solid fa-plus me-2"></i>Create New Handover</a>
</div>

<div class="row">
    <!-- Quick Stats -->
    <div class="col-md-3 mb-3">
        <div class="card border-primary shadow h-100 py-2 border-start border-4">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Active Patients</div>
                <div class="h5 mb-0 font-weight-bold text-dark">24</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-warning shadow h-100 py-2 border-start border-4">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending Tasks</div>
                <div class="h5 mb-0 font-weight-bold text-dark">12</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-danger shadow h-100 py-2 border-start border-4">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Critical Patients</div>
                <div class="h5 mb-0 font-weight-bold text-dark">2</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-success shadow h-100 py-2 border-start border-4">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Completed Handovers</div>
                <div class="h5 mb-0 font-weight-bold text-dark">18</div>
            </div>
        </div>
    </div>
</div>

<!-- Modules -->
<div class="row mt-4">
    <div class="col-md-4 mb-4">
        <div class="card shadow h-100 border-0">
            <div class="card-header bg-white fw-bold border-bottom-0 pt-3 pb-0">
                <i class="fa-solid fa-right-left text-primary me-2"></i>Patient Handovers
            </div>
            <div class="card-body">
                <p class="text-muted">View assigned handovers, acknowledge receipts, and read special instructions from the previous shift.</p>
                <a asp-area="ChargeNurse" asp-controller="Handover" asp-action="Index" class="btn btn-primary w-100 mt-2">View Handovers</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow h-100 border-0">
            <div class="card-header bg-white fw-bold border-bottom-0 pt-3 pb-0">
                <i class="fa-solid fa-pills text-success me-2"></i>Medication Tasks
            </div>
            <div class="card-body">
                <p class="text-muted">Check pending medication administration tasks and mark them as completed for the current shift.</p>
                <a asp-area="ChargeNurse" asp-controller="Task" asp-action="Index" class="btn btn-success w-100 mt-2">View Tasks</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card shadow h-100 border-0">
            <div class="card-header bg-white fw-bold border-bottom-0 pt-3 pb-0">
                <i class="fa-solid fa-notes-medical text-warning me-2"></i>Patient Notes
            </div>
            <div class="card-body">
                <p class="text-muted">Add clinical notes, update patient status, and log special instructions for the incoming shift.</p>
                <a asp-area="ChargeNurse" asp-controller="Notes" asp-action="Index" class="btn btn-warning w-100 mt-2">Manage Notes</a>
            </div>
        </div>
    </div>
</div>