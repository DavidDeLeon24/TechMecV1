@{
    ViewData["Title"] = "Charge Nurse";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Welcome Charge Nurse</h1>

<p>Select an option below:</p>

<div class="row">

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">

                <h3>Handovers</h3>
                <p>View patient handovers.</p>

                <a asp-area="ChargeNurse"
                   asp-controller="Handover"
                   asp-action="Index"
                   class="btn btn-primary">
                    View Handovers
                </a>

            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card">
            <div class="card-body">

                <h3>Tasks</h3>
                <p>View and update patient tasks.</p>

                <a asp-area="ChargeNurse"
                   asp-controller="Task"
                   asp-action="Index"
                   class="btn btn-primary">
                    View Tasks
                </a>

            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card">
            <div class="card-body">

                <h3>Notes</h3>
                <p>Add notes for the current shift.</p>

                <a asp-area="ChargeNurse"
                   asp-controller="Notes"
                   asp-action="Create"
                   class="btn btn-primary">
                    Add Note
                </a>

            </div>
        </div>
    </div>

</div>