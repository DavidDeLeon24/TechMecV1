@model TechMec.Models.TaskItem

@{
    ViewData["Title"] = "Create Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create New Patient Task</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-area="ChargeNurse" asp-controller="Task" asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="HandoverId" class="control-label fw-bold">Select Handover</label>
                            <select asp-for="HandoverId" class="form-select" asp-items="ViewBag.HandoverId">
                                <option value="">-- Select Handover --</option>
                            </select>
                            <span asp-validation-for="HandoverId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="control-label fw-bold">Task Description</label>
                            <input asp-for="Description" class="form-control" placeholder="e.g., Administer 50mg Medication X" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Priority" class="control-label fw-bold">Priority</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end border-top pt-3">
                            <a href="/ChargeNurse/Task" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create Task</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}