@model TechMec.Models.TaskItem

@{
    ViewData["Title"] = "Update Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Update Task</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-area="ChargeNurse" asp-controller="Task" asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="TaskId" />

                        <h5 class="mb-3">@Model.Description</h5>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Priority</label>
                            <input asp-for="Priority" class="form-control" readonly />
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input fs-5" asp-for="IsCompleted" />
                            <label class="form-check-label fs-5 ms-2" asp-for="IsCompleted">
                                Mark as Completed
                            </label>
                        </div>

                        <div class="d-flex justify-content-end border-top pt-3">
                            <a href="/ChargeNurse/Task" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}